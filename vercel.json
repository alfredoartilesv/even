{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "regions": ["cdg1"],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "develop": true,
      "master": true
    }
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api?__path=/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "/api?__path=/health"
    },
    {
      "source": "/mcp",
      "destination": "/api?__path=/mcp"
    },
    {
      "source": "/mcp/health",
      "destination": "/api?__path=/mcp/health"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api?__path=/oauth/:path*"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api?__path=/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api?__path=/.well-known/oauth-protected-resource/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp/health",
      "destination": "/api?__path=/.well-known/oauth-protected-resource/mcp/health"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api?__path=/.well-known/oauth-authorization-server"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "src/db/migrations/**"
    }
  }
}
