# Copy to .env and fill in. .env is git-ignored; this example file is committed.
# Garmin Connect personal API key, for scripts/garmin-sync.ts (on the phone the key goes in Settings and the Keystore).
# Make one in Garmin Connect on the web: Settings -> Personal API Key (https://connect.garmin.com/app/settings/personalApiToken).
GARMIN_API_KEY=
# Only for scripts/claude-chat.ts (on the phone the key goes in Settings and the Keystore)
ANTHROPIC_API_KEY=
# Google sign-in: the Web OAuth client id (public, not a secret). Only VITE_* values reach the app build:
# never give a secret a VITE_ name.
VITE_GOOGLE_WEB_CLIENT_ID=
