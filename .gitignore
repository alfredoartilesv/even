node_modules/
dist/
# APK exported by `npm run docker:apk`
out/
.env
.env.*
*.log
.DS_Store

# Capacitor native projects (regenerate with `npx cap add android|ios`)
# Remove these two lines if you decide to commit the native projects.
/android/
/ios/

# Keep the committed template
!.env.example

# Local databases (contain health data)
*.sqlite
*.sqlite-journal

# Data exports to import (Garmin ZIP etc.): health data, never committed. Only the README is.
imports/*
!imports/README.md

# Signing keys (the release key lives outside the repo: docs/dev-setup.md section 6)
*.jks
*.keystore
