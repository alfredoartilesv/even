{
  "name": "even",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --mode web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint src tests scripts server api --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dupes": "node scripts/dupes.mjs --max 1",
    "audit": "npm audit --omit=dev --audit-level=high",
    "health": "npm run format:check && npm run lint && npm run typecheck && npm run dupes && npm test",
    "test": "tsx --import ./tests/setup.ts --test tests/*.test.ts",
    "test:device": "node --env-file-if-exists=.env --import tsx scripts/device-test.ts",
    "docker:test": "docker build --target test .",
    "docker:apk": "docker build --target apk --output out .",
    "docker:release": "node scripts/docker-release.mjs",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "sync:server": "node --env-file-if-exists=.env --import tsx server/node.ts",
    "sync:migrate": "node --env-file-if-exists=.env --import tsx server/cli.ts migrate",
    "sync:phone": "node --env-file-if-exists=.env --import tsx scripts/sync-phone.ts",
    "test:sync": "node --env-file-if-exists=.env --import tsx scripts/sync-smoke.ts",
    "vercel-build": "node --import tsx server/cli.ts migrate && npm run build:web",
    "release:check": "node scripts/release-check.mjs",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android && node scripts/android-harden.mjs",
    "ios:sync": "npm run build && npx cap sync ios && node scripts/ios-harden.mjs",
    "ios:icons": "node scripts/ios-icons.mjs",
    "spike:drizzle": "tsx scripts/drizzle-spike.ts",
    "chat": "node --env-file=.env --import tsx scripts/claude-chat.ts",
    "import:garmin": "tsx scripts/garmin-import.ts",
    "sync:garmin": "node --env-file=.env --import tsx scripts/garmin-sync.ts",
    "docs:screens": "tsx scripts/screens/capture.ts",
    "perf:device": "node scripts/perf-device.mjs",
    "sync:invite": "node --env-file-if-exists=.env --import tsx server/cli.ts invite",
    "sync:accounts": "node --env-file-if-exists=.env --import tsx server/cli.ts accounts",
    "dev:web": "node scripts/dev-web.mjs",
    "sync:admin": "node --env-file-if-exists=.env --import tsx server/cli.ts admin"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-health": "8.11.11",
    "@capgo/capacitor-social-login": "^8.7.5",
    "@capgo/capacitor-speech-recognition": "8.4.1",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fflate": "^0.8.3",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "postgres": "3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@electric-sql/pglite": "0.5.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-orm": "^0.45.4",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
