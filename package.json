{
  "name": "health-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./tests/setup.ts --test tests/*.test.ts",
    "test:device": "node --env-file-if-exists=.env --import tsx scripts/device-test.ts",
    "docker:test": "docker build --target test .",
    "docker:apk": "docker build --target apk --output out .",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android && node scripts/android-harden.mjs",
    "spike:drizzle": "tsx scripts/drizzle-spike.ts",
    "chat": "node --env-file=.env --import tsx scripts/claude-chat.ts",
    "import:garmin": "tsx scripts/garmin-import.ts",
    "sync:garmin": "node --env-file=.env --import tsx scripts/garmin-sync.ts",
    "docs:screens": "tsx scripts/screens/capture.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-social-login": "^8.7.5",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-orm": "^0.45.4",
    "sql.js": "^1.15.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
